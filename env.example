# ─────────────────────────────────────────────────────────────
#  StockIndexer — Environment Variables
#  Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────────────

# WebSocket URL — pieBot broadcasts signals to this endpoint
# Dev:  ws://localhost:3001
# Prod: wss://your-conway-cloud-server.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Webhook secret — TradingView alert header: x-webhook-secret
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here

# pieBot webhook URL — stockindexer forwards valid signals here
PIEBOT_WEBHOOK_URL=https://your-conway-cloud.com/webhook

# GitHub — for /api/journal reading soul.md trade log
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your-username/your-private-repo

# Anthropic API (optional) — AI signal explanation feature
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────────────────────────
#  Supabase — Auth + Database
#  Get from: https://supabase.com/dashboard → Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key (public — safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (SECRET — never expose to client)
# Used for admin operations: set user tier after payment
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
